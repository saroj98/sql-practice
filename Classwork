from pyspark.sql.functions import lit, col


def car(spark):
    data = [
        ("Ford Torino", 140, 3449, "US"),
        ("Chevrolet Monte Carlo", 150, 3761, "US"),
        ("BMW 2002", 113, 2234, "Europe")
    ]
    columns = ["carr", "horsepower", "weight", "origin"]
    df = spark.createDataFrame(data=data, schema=columns)
    df.printSchema()
    df.show(truncate=False)
    dff = df.withColumnRenamed("carr", "car")
    dff = df.withColumn("AvgWeight", lit(200))
    dff = df.withColumn("kilowatt_power", col("horsepower") * 1000)
    dff.show(truncate=False)
