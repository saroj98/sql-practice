-- Write an SQL query to report the names of all the salespersons who did not have any orders related to the company with the name "RED".
-- Return the result table in any order.

SELECT s.name
FROM salesperson s
WHERE NOT EXISTS (
    SELECT 1
    FROM orders o
    JOIN company c
        ON o.com_id = c.com_id
    WHERE o.sales_id = s.sales_id
      AND c.name = 'RED'
);
-- step1: sales person and select one sales person at a time
--so we have sales id=1 and name is JOHN then look at ORDER table for column order_id, com_id, sales_id so sales_id 1 belongs to com_id 1 so com_id = 1 → Company = RED. then query returns 1 Exits = true so Jhon is not returned 
